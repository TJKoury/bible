{
  "name": "scripture-study",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "data": "python3 scripts/download_data.py",
    "test": "python3 -m unittest discover -s tests && node --test tests/*.test.js",
    "check": "svelte-check --fail-on-warnings",
    "build": "vite build",
    "verify:data": "python3 scripts/verify_data.py",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
